# ==========================================
# Wayora Backend Environment Configuration
# Copy this file to .env and adjust values
# ==========================================

# Django core settings
# Environments: 'development' or 'production'
DJANGO_ENV=development

# DJANGO_SECRET_KEY is strictly REQUIRED in production environments.
# In development, leave blank to generate an ephemeral key or provide a local dev key.
DJANGO_SECRET_KEY=

# Set to False in production
DJANGO_DEBUG=True

# Comma-separated allowed hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=wayora_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# Set to 1 to run the automated test suite against PostgreSQL instead of in-memory SQLite
USE_POSTGRES_FOR_TESTS=0

# CORS Configuration (Allowed frontend origin URLs)
# REQUIRED in production: specify your production frontend domains (e.g. https://app.wayora.io)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Optional dedicated signing key (defaults to DJANGO_SECRET_KEY if left blank)
JWT_SIGNING_KEY=

# AWS / Object Storage Configuration (For Blueprint CAD/SVG/PNG files)
# Set to True when Amazon S3 credentials are configured
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=wayora-blueprints
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_DEFAULT_ACL=private
AWS_PRESIGNED_EXPIRY_SECONDS=3600
